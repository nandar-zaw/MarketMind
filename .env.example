# MarketMind environment variables (Phase 1 placeholders)
# Copy this file to .env and fill in values when needed in later phases.

# Optional: OpenAI API key for LLM-based agents (later phases)
OPENAI_API_KEY=

# Optional: News API key for sentiment analysis (Phase 3+)
NEWS_API_KEY=

# Optional: OpenAI vector store ID with SEC filings (10-K/10-Q)
# for the Fundamental Analysis agent (RAG via FileSearchTool)
FUNDAMENTALS_VECTOR_STORE_ID=

# Optional: App settings
APP_ENV=development
