# MarketMind environment variables (Phase 1 placeholders)
# Copy this file to .env and fill in values when needed in later phases.

# Optional: OpenAI API key for LLM-based Sentiment scoring.
# If unset, Sentiment uses a keyword fallback on DataAgent headlines.
OPENAI_API_KEY=

# Optional: News API key (unused; news comes from yfinance via DataAgent)
NEWS_API_KEY=

# Legacy / optional: SEC filing vector store for single-stock RAG demos.
# Not required for S&P 500 (SPY). Fundamental Agent uses DataAgent
# yfinance fundamentals by default.
FUNDAMENTALS_VECTOR_STORE_ID=

# Optional: App settings
APP_ENV=development
